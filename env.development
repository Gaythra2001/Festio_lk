# ============================================================================
# FESTIO LK - Local Development Environment Configuration
# ============================================================================
# Copy this file to .env and configure for your local setup
# Choose EITHER Firebase Emulator (Option 1) OR Real Firebase (Option 2)

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/festio_lk_dev
# Alternative: SQLite for quick local testing
# DATABASE_URL=sqlite:///./festio_lk.db

# ============================================================================
# FIREBASE CONFIGURATION - OPTION 1: Firebase Emulator (RECOMMENDED)
# ============================================================================
# Uncomment these lines and set USE_FIREBASE_EMULATOR=true to use local emulator

USE_FIREBASE_EMULATOR=true

# For emulator mode, these can be dummy values (emulator doesn't validate)
FIREBASE_PROJECT_ID=festio-lk-emulator
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-emulator@festio-lk-emulator.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQCy123456789FAKE\nKEY+X3qVeXCqBfREpTnIQeRzQn2QvO+x123456789FAKEKEYLINE2+3FAKEKEYLINE3\n-----END PRIVATE KEY-----\n

# Emulator hosts (default ports)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ============================================================================
# FIREBASE CONFIGURATION - OPTION 2: Real Firebase Project
# ============================================================================
# COMMENT OUT the OPTION 1 lines above and uncomment these for real Firebase
# Follow LOCAL_FIREBASE_SETUP.md Option 2 to get these values

# USE_FIREBASE_EMULATOR=false
# FIREBASE_PROJECT_ID=your-actual-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# ============================================================================
# JWT/Security Settings (Legacy - can be disabled with Firebase Auth)
# ============================================================================
SECRET_KEY=your-super-secret-dev-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# CORS Settings
# ============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:5500","http://localhost:5500"]
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=user
# SMTP_PASSWORD=password
# EMAILS_FROM_EMAIL=noreply@festio.lk

# ============================================================================
# API Configuration
# ============================================================================
API_V1_STR=/api/v1
PROJECT_NAME=Festio LK

# ============================================================================
# ML Model Configuration
# ============================================================================
# Path to local ML models (for testing/development)
# MODELS_PATH=./ml_services/models/

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_ML_RECOMMENDATIONS=true
ENABLE_REVENUE_OPTIMIZATION=true
ENABLE_ORGANIZER_CHATBOT=true
ENABLE_ANALYTICS=true

# ============================================================================
# INSTRUCTIONS:
# ============================================================================
# 1. For Firebase Emulator (Recommended for development):
#    - Ensure Google Cloud CLI is installed: https://cloud.google.com/sdk/docs/install
#    - Start emulator: firebase emulators:start --project=festio-lk-emulator
#    - Keep USE_FIREBASE_EMULATOR=true above
#    - Backend will auto-connect to emulator on startup
#
# 2. For Real Firebase Project:
#    - Create Firebase project: https://console.firebase.google.com
#    - Enable Firestore, Authentication, Storage
#    - Download service account JSON from Firebase Console
#    - Follow LOCAL_FIREBASE_SETUP.md Option 2 for detailed steps
#    - Replace FIREBASE_* values with your credentials
#    - Set USE_FIREBASE_EMULATOR=false
#
# 3. Start Backend:
#    cd backend
#    python run.py    # Will run on http://0.0.0.0:8000
#
# 4. Verify:
#    - Check console output for "✅ Firestore initialized successfully"
#    - Open http://localhost:8000/docs for API documentation
#    - Test endpoints via Swagger UI
